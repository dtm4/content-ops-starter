# Copy to .env and fill in. Never commit the real .env.

# Lithic sandbox API key (dashboard -> API keys, sandbox environment).
LITHIC_API_KEY=
# sandbox (default) or production. Production also needs ALLOW_PRODUCTION_CARDS=yes.
LITHIC_ENVIRONMENT=sandbox
ALLOW_PRODUCTION_CARDS=no
# Hand full card numbers to agents in production too. Lithic only returns them
# to PCI-compliant programs, and they pass through your AI provider.
ALLOW_PRODUCTION_CARD_DETAILS=no

# Employee this MCP server spends for; must be in employees.json.
# Run one MCP server per employee. Agents cannot change it.
SPEND_EMPLOYEE_ID=

# Slack app: Incoming Webhook URL for the approval channel.
SPEND_APPROVAL_WEBHOOK=
# Slack app: Basic Information -> Signing Secret.
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to approve or deny (e.g. U012ABCDEF).
SLACK_APPROVER_IDS=
